# Template for /srv/notes/.env on the server (owner deploy, mode 600). Never commit the real file.
# docker compose reads it to fill ${...} in compose.yaml and compose.prod.yaml.

# The hostname Caddy gets a certificate for: the server's IPv4 address with dashes + .sslip.io
NOTES_SITE=203-0-113-10.sslip.io
# Let's Encrypt account address (expiry warnings only; never shown publicly)
ACME_EMAIL=you@example.com
# openssl rand -hex 32   (hex is safe inside the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Not here: the JWT key and the Redis password are files in /srv/notes/.secrets/
# (notes_jwt_secret, notes_redis_password). Admins are promoted with a command, not by e-mail:
#   deploy/production/dc run --rm --no-deps migrate python -m notes_api.manage promote-admin <email>
